# Environment variables for the project

# Hugging Face access token.
# Required for gated or private models when using vLLM.
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Conda environment configuration
# Name of the Conda environment to use for vLLM.
# Leave empty to use the currently active Python interpreter.
# The install_vllm.sh script will create and activate this environment if needed.
CONDA_ENV=example_env

# Logging configuration
# Minimum log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# If true, logs are also written to a file in the LOG_DIR directory.
LOG_TO_FILE=false

# Directory where log files are stored when LOG_TO_FILE is true.
LOG_DIR=logs

# Name of the log file. Leave empty to use a timestamped name.
LOG_FILENAME=
