# Environment variables for the project

# Hugging Face access token.
# Required for gated or private models when using vLLM or Diffusers.
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Conda environment configuration
# Name of the Conda environment to use para todo el proyecto.
# Si estás usando conda, asegúrate de colocar aquí el nombre de tu entorno.
CONDA_ENV=llm_env

# Logging configuration
# Minimum log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# If true, logs are also written to a file in the LOG_DIR directory.
LOG_TO_FILE=true

# Directory where log files are stored when LOG_TO_FILE is true.
LOG_DIR=logs

# Name of the log file. Leave empty to use a timestamped name.
LOG_FILENAME=

# Path to cache AI models (HuggingFace/Diffusers). 
# Can be absolute (e.g. /mnt/ai-storage/models) or relative to the project root.
MODELS_DIR=./models
